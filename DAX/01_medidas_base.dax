// =============================================================================
// MEDIDAS BASE — usadas como fundação para todas as outras páginas
// =============================================================================

Receita Total =
CALCULATE(
    SUMX(
        fato_ItensVenda,
        fato_ItensVenda[preco_unitario] * fato_ItensVenda[quantidade] * (1 - fato_ItensVenda[desconto_percentual])
    ),
    fato_ItensVenda[status_pedido] = "Concluído"
)

Custo Total =
CALCULATE(
    SUMX(fato_ItensVenda, fato_ItensVenda[custo_unitario] * fato_ItensVenda[quantidade]),
    fato_ItensVenda[status_pedido] = "Concluído"
)

Lucro Total = [Receita Total] - [Custo Total]

Margem % = DIVIDE([Lucro Total], [Receita Total])

Número de Pedidos =
CALCULATE(
    DISTINCTCOUNT(fato_ItensVenda[pedido_id]),
    fato_ItensVenda[status_pedido] = "Concluído"
)

Número de Clientes =
CALCULATE(
    DISTINCTCOUNT(fato_ItensVenda[cliente_id]),
    fato_ItensVenda[status_pedido] = "Concluído"
)

Ticket Médio = DIVIDE([Receita Total], [Número de Pedidos])

// Pedidos cancelados — para monitorar saúde operacional (não some do modelo)
Pedidos Cancelados =
CALCULATE(
    DISTINCTCOUNT(fato_ItensVenda[pedido_id]),
    fato_ItensVenda[status_pedido] = "Cancelado"
)

Taxa de Cancelamento =
VAR TotalPedidos =
    CALCULATE(DISTINCTCOUNT(fato_ItensVenda[pedido_id]), ALL(fato_ItensVenda[status_pedido]))
RETURN
    DIVIDE([Pedidos Cancelados], TotalPedidos)

// % que este contexto representa do total geral (usa REMOVEFILTERS para
// ignorar qualquer filtro de página/slicer e sempre trazer o total absoluto)
% da Receita Total =
DIVIDE(
    [Receita Total],
    CALCULATE([Receita Total], REMOVEFILTERS())
)
