// =============================================================================
// PÁGINA 4 — GEOGRAFIA
// ALL, REMOVEFILTERS, CALCULATE, DIVIDE, VAR, IF
// =============================================================================

Margem % Nacional = CALCULATE([Margem %], REMOVEFILTERS(dim_Estados))

Gap Margem vs Nacional = [Margem %] - [Margem % Nacional]

// Sinaliza estados cuja margem está abaixo da média nacional, mesmo que
// tenham receita relevante — a base do insight "SP pesa na receita, mas
// pesa menos na margem"
Alerta Margem Estado =
IF(
    [Gap Margem vs Nacional] < -0.03,
    "⚠ Margem abaixo da média nacional",
    "OK"
)

% Receita do Estado sobre o Total =
DIVIDE([Receita Total], CALCULATE([Receita Total], REMOVEFILTERS(dim_Estados)))

Ticket Médio por Estado = DIVIDE([Receita Total], [Número de Pedidos])

Ranking Estado por Receita =
RANKX(ALL(dim_Estados[uf]), CALCULATE([Receita Total]), , DESC, DENSE)

// Receita da região vs. média das outras regiões (para comparar Sudeste x resto do Brasil)
Margem % da Região =
CALCULATE([Margem %], ALL(dim_Estados[uf]), VALUES(dim_Estados[regiao]))
