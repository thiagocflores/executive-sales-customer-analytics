// =============================================================================
// PÁGINA 1 — VISÃO EXECUTIVA
// Inteligência de tempo: DATEADD, SAMEPERIODLASTYEAR, VAR, SWITCH
// =============================================================================

Receita Mês Anterior =
CALCULATE([Receita Total], DATEADD(dim_Calendario[data], -1, MONTH))

Receita Ano Anterior =
CALCULATE([Receita Total], SAMEPERIODLASTYEAR(dim_Calendario[data]))

Crescimento MoM % =
VAR ReceitaAtual = [Receita Total]
VAR ReceitaAnterior = [Receita Mês Anterior]
RETURN
    DIVIDE(ReceitaAtual - ReceitaAnterior, ReceitaAnterior)

Crescimento YoY % =
VAR ReceitaAtual = [Receita Total]
VAR ReceitaAnoAnterior = [Receita Ano Anterior]
RETURN
    DIVIDE(ReceitaAtual - ReceitaAnoAnterior, ReceitaAnoAnterior)

// Receita acumulada (running total) — usa CALCULATE + FILTER + ALL para
// somar tudo até a data mais recente do contexto atual
Receita Acumulada =
CALCULATE(
    [Receita Total],
    FILTER(
        ALL(dim_Calendario[data]),
        dim_Calendario[data] <= MAX(dim_Calendario[data])
    )
)

Lucro Acumulado =
CALCULATE(
    [Lucro Total],
    FILTER(
        ALL(dim_Calendario[data]),
        dim_Calendario[data] <= MAX(dim_Calendario[data])
    )
)

// Meta x Realizado --------------------------------------------------------
Meta Receita = SUM(fato_Metas[meta_receita])

Gap vs Meta = [Receita Total] - [Meta Receita]

% Atingimento Meta = DIVIDE([Receita Total], [Meta Receita])

// SWITCH + IF para o indicador visual (usado como cor condicional no cartão)
Status Meta =
SWITCH(
    TRUE(),
    ISBLANK([Meta Receita]), "Sem meta definida",
    [% Atingimento Meta] >= 1, "Meta batida ✅",
    [% Atingimento Meta] >= 0.9, "Próximo da meta ⚠",
    "Abaixo da meta ❌"
)

// Cor da medida (para usar em "Formatação Condicional > Cor da Fonte" via
// medida, campo tipo texto reconhecido pelo Power BI)
Cor Status Meta =
SWITCH(
    TRUE(),
    [% Atingimento Meta] >= 1, "#1E7B34",   -- verde (lucro/meta batida)
    [% Atingimento Meta] >= 0.9, "#C77700", -- âmbar
    "#B3261E"                               -- vermelho (prejuízo/abaixo da meta)
)
