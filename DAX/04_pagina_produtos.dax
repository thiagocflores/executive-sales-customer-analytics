// =============================================================================
// PÁGINA 3 — PRODUTOS
// RANKX, IF, VAR, CALCULATE, FILTER, ALL, HASONEVALUE
// =============================================================================

Quantidade Vendida =
CALCULATE(SUM(fato_ItensVenda[quantidade]), fato_ItensVenda[status_pedido] = "Concluído")

Desconto Médio % =
CALCULATE(AVERAGE(fato_ItensVenda[desconto_percentual]), fato_ItensVenda[status_pedido] = "Concluído")

Margem % Produto = DIVIDE([Lucro Total], [Receita Total])

// Ranking por volume (quantidade) e por lucro — usados nos Top N de cada visual
Ranking Produto por Volume =
RANKX(ALL(dim_Produtos[produto_id]), CALCULATE([Quantidade Vendida]), , DESC, DENSE)

Ranking Produto por Lucro =
RANKX(ALL(dim_Produtos[produto_id]), CALCULATE([Lucro Total]), , DESC, DENSE)

// *** Medida-chave da página: identifica produtos que vendem muito mas
// lucram pouco (o "diferencial" pedido no case) ***
// Regra: está entre os 20% mais vendidos (por volume) E tem margem abaixo
// da margem média geral do negócio.
Vende Muito e Lucra Pouco =
VAR TotalProdutos = CALCULATE(DISTINCTCOUNT(dim_Produtos[produto_id]), ALL(dim_Produtos))
VAR PosicaoLimiteVolume = ROUNDUP(TotalProdutos * 0.20, 0)
VAR MargemMediaGeral = CALCULATE([Margem %], ALL(dim_Produtos))
RETURN
    IF(
        HASONEVALUE(dim_Produtos[produto_id]),
        IF(
            [Ranking Produto por Volume] <= PosicaoLimiteVolume && [Margem % Produto] < MargemMediaGeral,
            "⚠ Vende muito, lucra pouco",
            "OK"
        ),
        "Vários Produtos"
    )

// Diferença da margem do produto vs. a margem média do negócio (para tooltip)
Gap Margem vs Média =
[Margem % Produto] - CALCULATE([Margem %], ALL(dim_Produtos))

// Classificação de perfil (para color coding nos gráficos)
Classificação Margem =
SWITCH(
    TRUE(),
    NOT HASONEVALUE(dim_Produtos[produto_id]), "Vários Produtos",
    [Margem % Produto] < 0.15, "Margem Crítica",
    [Margem % Produto] < 0.30, "Margem Saudável",
    "Margem Premium"
)
