// =============================================================================
// PÁGINA 5 — COMERCIAL
// RANKX, SWITCH, CALCULATE, ALL, SAMEPERIODLASTYEAR
// =============================================================================

Ranking Categoria = RANKX(ALL(dim_Produtos[categoria]), CALCULATE([Receita Total]), , DESC, DENSE)

Ranking Subcategoria = RANKX(ALL(dim_Produtos[subcategoria]), CALCULATE([Receita Total]), , DESC, DENSE)

Ranking Canal = RANKX(ALL(fato_ItensVenda[canal_venda]), CALCULATE([Receita Total]), , DESC, DENSE)

Ranking Vendedor = RANKX(ALL(dim_Vendedores[vendedor_id]), CALCULATE([Receita Total]), , DESC, DENSE)

// Rótulo dinâmico do Top 1 em cada dimensão comercial (útil em cartões de destaque)
Top Categoria =
CALCULATE(
    SELECTEDVALUE(dim_Produtos[categoria]),
    TOPN(1, ALL(dim_Produtos[categoria]), CALCULATE([Receita Total]), DESC)
)

Top Vendedor =
CALCULATE(
    SELECTEDVALUE(dim_Vendedores[nome_vendedor]),
    TOPN(1, ALL(dim_Vendedores[nome_vendedor]), CALCULATE([Receita Total]), DESC)
)

// Comparativo Ano Atual x Ano Anterior por canal/categoria (a mesma medida de
// tempo da página 1, reaproveitada em qualquer contexto de página comercial)
Receita Ano Anterior (Comercial) = CALCULATE([Receita Total], SAMEPERIODLASTYEAR(dim_Calendario[data]))

Crescimento YoY % (Comercial) =
DIVIDE([Receita Total] - [Receita Ano Anterior (Comercial)], [Receita Ano Anterior (Comercial)])

// Classifica o desempenho do canal/categoria/vendedor em relação à média geral
Desempenho vs Média =
SWITCH(
    TRUE(),
    [Margem %] > CALCULATE([Margem %], REMOVEFILTERS()) + 0.05, "Acima da média",
    [Margem %] < CALCULATE([Margem %], REMOVEFILTERS()) - 0.05, "Abaixo da média",
    "Na média"
)
